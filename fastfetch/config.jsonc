// ___________                __    _____       __         .__
// \_   _____/____    _______/  |__/ ____\_____/  |_  ____ |  |__
//  |    __) \__  \  /  ___/\   __\   __\/ __ \   __\/ ___\|  |  \
//  |     \   / __ \_\___ \  |  |  |  | \  ___/|  | \  \___|   Y  \
//  \___  /  (____  /____  > |__|  |__|  \___  >__|  \___  >___|  /
//      \/        \/     \/                  \/          \/     \/
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
"logo": {
    "source": "~/.config/fastfetch/Logo.png",
    "type": "kitty-direct",
    "position": "left",
    "width": 42,
    "height": 19,
    "padding": {
        "top": 0,
        "bottom": 0,
        "left": 0,
        "right": 5
    }
},
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#31} user    {#keys}│",
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        {

            "key": "│ {#33}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "│ {#34}{icon} distro  {#keys}│",
            "type": "os",
            "format": "{name}"

        },
        {
            "key": "│ {#35} kernel  {#keys}│",
            "type": "kernel"

        },
        {
            "key": "│ {#36}󰇄 desktop {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {#31} term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#32} shell   {#keys}│",
            "type": "shell"
        },
        {

            "key": "│ {#32} Packages{#keys}│",
            "type": "packages"

        },
        {

            "key": "╰───────────╯",
            "type": "custom"

        },
        {

            "key": "╭───────────╮",
            "type": "custom"

        },
        {

            "key": "│ {#33}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {

            "key": "│ {#31} gpu     {#keys}│",
            "type": "gpu"

        },
        {

            "key": "│ {#34}󰉉 disk    {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {#35} memory  {#keys}│",
            "type": "memory"
        },
        {
            "key": "│ {#36}󰣸 network {#keys}│",
            "type": "localip",
            "format": "{ipv4} ({ifname})"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {

            "key": "│ {#36} font    {#keys}│",
            "type": "terminalfont"

        },
        {
            "key": "│ {#39} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
